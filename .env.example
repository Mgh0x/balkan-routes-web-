# Copy this file to .env.local and fill in real credentials.

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Option A: SMTP (Gmail app password, hosting email, Yandex, etc.)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Skopje Routes <your-address@example.com>"
EMAIL_REPLY_TO=hello@skopjeroutes.mk
CONTACT_TO_EMAIL=hello@skopjeroutes.mk
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-google-app-password

# Option B: Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM="Skopje Routes <onboarding@resend.dev>"
